
@baseUrl = http://localhost:4004



### 1.1 GET all books 
GET {{baseUrl}}/browse/Books
Accept: application/json

###1.2 GET books with high stock (>100) 
GET {{baseUrl}}/browse/Books?$filter=stock gt 100&$select=ID,title,stock
Accept: application/json

### 1.3 GET books with low stock (1-5)
GET {{baseUrl}}/browse/Books?$filter=stock gt 0 and stock le 5&$select=ID,title,stock
Accept: application/json

### 1.4 GET out-of-stock books (stock = 0) 
GET {{baseUrl}}/browse/Books?$filter=stock eq 0&$select=ID,title,stock
Accept: application/json

### 1.5 GET a single book with expanded author
GET {{baseUrl}}/browse/Books(251)?$expand=author
Accept: application/json

### 1.6 GET books by a specific author
GET {{baseUrl}}/browse/Books?$filter=author/name eq 'Edgar Allan Poe'&$select=ID,title,stock
Accept: application/json

### 1.7 GET books with price between 15 and 25
GET {{baseUrl}}/browse/Books?$filter=price ge 15 and price le 25&$select=ID,title,price
Accept: application/json


### 2.1 GET all authors
GET {{baseUrl}}/admin/Authors?$select=ID,name
Accept: application/json

### 2.2 GET all books 
GET {{baseUrl}}/admin/Books
Accept: application/json

### 2.3 GET all genres
GET {{baseUrl}}/admin/Genres?$select=ID,name
Accept: application/json

### 2.4 CREATE a new author 
POST {{baseUrl}}/admin/Authors
Content-Type: application/json

{
    "name": "J.K. Rowling"
}

### 2.5 CREATE a new book 
POST {{baseUrl}}/admin/Books
Content-Type: application/json

{
    "title": "Harry Potter and the Philosopher's Stone",
    "stock": 50,
    "price": 29.99,
    "author_ID": 181,
    "genre_ID": 13
}

### 2.6 CREATE a book with missing title -gives an error
POST {{baseUrl}}/admin/Books
Content-Type: application/json

{
    "title": "",
    "stock": 10,
    "price": 19.99,
    "author_ID": 101,
    "genre_ID": 11
}

### 2.7 CREATE a book with negative stock -error
POST {{baseUrl}}/admin/Books
Content-Type: application/json

{
    "title": "Invalid Stock Book",
    "stock": -10,
    "price": 19.99,
    "author_ID": 101,
    "genre_ID": 11
}

### 2.8 CREATE a book with price out of range -error
POST {{baseUrl}}/admin/Books
Content-Type: application/json

{
    "title": "Too Expensive Book",
    "stock": 10,
    "price": 999,
    "author_ID": 101,
    "genre_ID": 11
}

### 2.9 UPDATE a book's stock
PATCH {{baseUrl}}/admin/Books(201)
Content-Type: application/json

{
    "stock": 25
}

### 2.10 DELETE a book
DELETE {{baseUrl}}/admin/Books(277)


### 3.1 CREATE a new order 
POST {{baseUrl}}/admin/Orders
Content-Type: application/json

{
    "customerName": "John Doe",
    "status": "PENDING"
}

### 3.2 CREATE order item for book with stock 
POST {{baseUrl}}/admin/OrderItems
Content-Type: application/json

{
    "book_ID": 201,
    "quantity": 2,
    "unitPrice": 19.99,
    "order_ID": "YOUR_ORDER_ID_FROM_3.1"
}

### 3.3 CREATE order item for OUT-OF-STOCK book -error
POST {{baseUrl}}/admin/OrderItems
Content-Type: application/json

{
    "book_ID": 273,
    "quantity": 1,
    "unitPrice": 22.99,
    "order_ID": "YOUR_ORDER_ID_FROM_3.1"
}

### 3.4 CREATE order item with quantity > stock 
POST {{baseUrl}}/admin/OrderItems
Content-Type: application/json

{
    "book_ID": 207,
    "quantity": 100,
    "unitPrice": 18.99,
    "order_ID": "YOUR_ORDER_ID_FROM_3.1"
}

